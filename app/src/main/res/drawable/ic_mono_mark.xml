<!-- Lean's monochrome brand mark — twin-sparkle silhouette, full-bleed in a 24dp
     viewport, for every place the system wants a small single-colour glyph rather
     than the padded adaptive-icon foreground: the notification small icon and the
     Quick Settings tile.

     Same two stars as ic_launcher_foreground (big primary + small companion sparkle,
     offset up-right). Their raw path data was authored for that file's group
     (translateX=30 translateY=30 scaleX=2 scaleY=2 over a 108dp canvas), where a
     LOT of surrounding safe-zone padding hides that the art's own bounding box is
     NOT centred on its nominal 24-unit box: measured combined bbox is
     x[-0.3,24.3] y[1.2,26.2], true centre (12, 13.7) — 1.7 units below the 24-unit
     midpoint. Re-hosting the paths at 1:1 scale with no compensation (as a prior
     fix here did) carries that 1.7-unit bias straight into a viewport with NO
     padding to absorb it, so the glyph sits low with its bottom tip flush against
     the edge — exactly the "shifted down" notification-icon symptom. The
     translateY below re-centres the measured bbox at y=12; x was already centred
     (bbox mid-x = 12) so no X shift is needed. Both paths are white — the system
     tints the pair as one shape per surface/tile-state, exactly like the
     light-theme top bar (HomeScreen.kt, R.mipmap.ic_launcher_fg) does when it
     tints this same twin-star art flat for that theme. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <group android:translateY="-1.7">
        <path
            android:fillColor="@android:color/white"
            android:pathData="M12 1.6c.45 4.1 1.6 6.9 3.5 8.8s4.7 3.05 8.8 3.5c-4.1.45-6.9 1.6-8.8 3.5s-3.05 4.7-3.5 8.8c-.45-4.1-1.6-6.9-3.5-8.8s-4.7-3.05-8.8-3.5c4.1-.45 6.9-1.6 8.8-3.5s3.05-4.7 3.5-8.8z" />
        <path
            android:fillColor="@android:color/white"
            android:pathData="M19.2 1.2c.2 1.55.62 2.6 1.32 3.3s1.75 1.12 3.3 1.32c-1.55.2-2.6.62-3.3 1.32s-1.12 1.75-1.32 3.3c-.2-1.55-.62-2.6-1.32-3.3s-1.75-1.12 -3.3-1.32c1.55-.2 2.6-.62 3.3-1.32s1.12-1.75 1.32-3.3z" />
    </group>
</vector>
