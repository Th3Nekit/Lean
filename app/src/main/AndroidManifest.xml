<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- requestNetwork() on API 28–30 for best-underlying-network tracking. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Auto-connect after a device reboot (gated by the autoConnect setting). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Lets «Работа в фоне» open the exemption request directly instead of dumping the
         user in the system battery list. Doze (and the vendor layers above it) will
         freeze this process despite the foreground service, which reads as the tunnel
         dropping on its own. Distributed outside Play, where this permission is
         restricted; a VPN is an allowed use case there in any event. -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="BatteryLife" />

    <!-- Per-app split-tunnel picker: list every installed package holding the
         INTERNET permission (background/companion apps route traffic without a
         launcher entry). Personal-use build, not a Play Store release, so the
         broad QUERY_ALL_PACKAGES visibility permission is acceptable here. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Launcher-app visibility kept as belt-and-braces alongside QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- Automation guard: third-party senders (Tasker etc.) declare this
         normal-level permission to drive AutomationReceiver; it is granted
         automatically at install. ${applicationId} keeps the debug build
         (com.th3web.lean.debug) from colliding with release on one device. -->
    <permission
        android:name="${applicationId}.permission.AUTOMATION"
        android:protectionLevel="normal" />

    <application
        android:name=".LeanApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lean"
        tools:targetApi="33">

        <!-- The MAIN/LAUNCHER entry lives on the Icon* activity-aliases BELOW
             (launcher-icon picker), NOT here: the VPN notification, the QS tile
             and shortcuts.xml all address .MainActivity EXPLICITLY, so this
             component must stay permanently enabled — only the aliases flip
             enabled state (core/AppIcon.kt). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Lean">
            <!-- Deep links: lean://connect | lean://disconnect | lean://toggle
                 (also the launcher shortcuts' route into the app), plus the
                 subscription-import links handed out in Telegram:
                   lean://import-sub?url=<enc>&name=<opt>
                   lean://install-config/?url=<enc>      (Hiddify-style alias)
                 BROWSABLE is what lets these open from a browser / Telegram tap. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="lean" />
                <data android:host="connect" />
                <data android:host="disconnect" />
                <data android:host="toggle" />
                <data android:host="import-sub" />
                <data android:host="install-config" />
            </intent-filter>
            <!-- QS tile long-press target: open the app at Home (not Settings).
                 Android routes a long-press on the tile to this action. -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Launcher-icon variants ("Иконка приложения" picker). Exactly ONE
             alias is enabled at any time — IconDefault from the manifest, the
             alternates via PackageManager.setComponentEnabledSetting
             (core/AppIcon.kt enables the new one BEFORE disabling the rest, so
             the launcher entry never vanishes). Alias names expand against the
             com.th3web.lean namespace, not the applicationId — keep them in sync
             with AppIcon.ALIASES. Static launcher shortcuts attach to whichever
             component carries MAIN/LAUNCHER, hence the shortcuts meta-data is
             repeated on every alias; the shortcut intents keep targeting
             .MainActivity (always enabled). -->
        <activity-alias
            android:name=".IconDefault"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

