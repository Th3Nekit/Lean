        <!-- External automation (Tasker / MacroDroid / adb). Since Android 8
             implicit broadcasts are not delivered to manifest receivers, so
             senders must address the component explicitly, e.g.:
               adb shell am broadcast \
                 -n com.th3web.lean/.core.AutomationReceiver \
                 -a com.th3web.lean.CONNECT
             Action strings are literals on purpose: the manifest cannot
             reference Kotlin consts. Keep in sync with core/AutomationReceiver.kt. -->
        <receiver
            android:name=".core.AutomationReceiver"
            android:exported="true"
            android:permission="${applicationId}.permission.AUTOMATION">
            <intent-filter>
                <action android:name="com.th3web.lean.CONNECT" />
                <action android:name="com.th3web.lean.DISCONNECT" />
                <action android:name="com.th3web.lean.TOGGLE" />
                <action android:name="com.th3web.lean.STATUS" />
            </intent-filter>
            <!-- Auto-connect after reboot. The system is the broadcaster for
                 these, so the AUTOMATION android:permission guard above does not
                 block them (it only constrains third-party senders). The handler
                 still no-ops unless the autoConnect setting is on. -->
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

